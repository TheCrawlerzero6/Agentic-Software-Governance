# === Pentesting para Desarrolladores — configuración local ===
# Copia este archivo a `.env` (docker compose lo lee automáticamente).
# Para uso 100% local los valores por defecto funcionan sin cambios.

# Identidad/owner con el que se guardan tus auditorías (no hay autenticación, es local).
AUDIT_OWNER=local

# Dominios extra permitidos como objetivo, separados por coma (ej: corp.local,intranet).
# Por defecto solo se permite localhost, host.docker.internal y redes privadas (RFC1918).
ALLOWED_TARGET_DOMAINS=

# Desfase horario (horas) para los timestamps. 0 = UTC. Ej: -5 para UTC-5.
TZ_OFFSET_HOURS=0
