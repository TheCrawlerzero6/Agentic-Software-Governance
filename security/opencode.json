{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "kali": {
      "type": "local",
      "command": ["docker", "exec", "-i", "pentesting-kali", "python3", "/opt/mcp-kali-server/client.py", "--server", "http://localhost:5000/"],
      "enabled": true
    },
    "browser": {
      "type": "remote",
      "url": "http://localhost:3478/sse",
      "enabled": true
    },
    "gateway": {
      "type": "remote",
      "url": "http://localhost:3480/mcp",
      "enabled": true
    }
  },
  "permission": {
    "*": "allow"
  },
  "instructions": [
    "reference/rules.md",
    "reference/mcp-tools.md",
    "reference/finding-format.md"
  ]
}
